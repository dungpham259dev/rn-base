{
  "name": "@rnbase/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:staging": "dotenv -e .env.staging -- next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "next dev",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "ui-add": "pnpm dlx shadcn@latest add && prettier src/components/ui --write --list-different"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@rnbase/api": "workspace:*",
    "@rnbase/i18n": "workspace:*",
    "@rnbase/store": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "^0.7.1",
    "next": "^16.0.9",
    "radix-ui": "^1.4.3",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rnbase/eslint-config": "workspace:*",
    "@rnbase/prettier-config": "workspace:*",
    "@rnbase/tailwind-config": "workspace:*",
    "@rnbase/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "dotenv-cli": "^10.0.0",
    "eslint": "catalog:",
    "jiti": "^2.5.1",
    "prettier": "catalog:",
